<Window x:Class="RsyncShell.App.Dialogs.TunnelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TunnelManagerTitle}"
        Width="850" Height="650" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource NewTunnel}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource TunnelSession}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ProfileInput" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                          DisplayMemberPath="DisplayName" MinHeight="29" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource TunnelMode}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ModeInput" Grid.Row="2" Grid.Column="1" MinHeight="29"
                          DisplayMemberPath="DisplayName" SelectionChanged="ModeInput_OnSelectionChanged" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{DynamicResource ListenAddress}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ListenInput" Grid.Row="2" Grid.Column="4" Text="127.0.0.1:1080" Padding="7,4" />

                <TextBlock x:Name="TargetLabel" Grid.Row="4" Grid.Column="0" Text="{DynamicResource TargetAddress}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TargetInput" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="127.0.0.1:80" Padding="7,4" />
                <Button Grid.Row="4" Grid.Column="4" Content="{DynamicResource StartTunnel}" Padding="18,5"
                        HorizontalAlignment="Right" Click="StartButton_OnClick" />

                <TextBlock x:Name="ValidationText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5"
                           Foreground="Firebrick" TextWrapping="Wrap" Margin="0,9,0,0" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{DynamicResource TunnelStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" VerticalAlignment="Top" />
        <DataGrid x:Name="TunnelGrid" Grid.Row="3" Margin="0,36,0,0"
                  ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="TunnelGrid_OnSelectionChanged"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource TunnelSession}" Binding="{Binding SessionName}" Width="1.4*" />
                <DataGridTextColumn Header="{DynamicResource TunnelMode}" Binding="{Binding Mode}" Width="1.2*" />
                <DataGridTextColumn Header="{DynamicResource TunnelRoute}" Binding="{Binding Route}" Width="2.6*" />
                <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="LogText" Grid.Row="5" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource CopyLog}" Padding="14,4" Margin="0,0,7,0" Click="CopyLogButton_OnClick" />
            <Button Content="{DynamicResource StopTunnel}" Padding="14,4" Margin="0,0,7,0" Click="StopButton_OnClick" />
            <Button Content="{DynamicResource StopAllTunnels}" Padding="14,4" Click="StopAllButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
