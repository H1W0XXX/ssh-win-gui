<Window x:Class="RsyncShell.App.Dialogs.TunnelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TunnelManagerTitle}"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Background="{StaticResource ChromeBrush}">
        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="150" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource TunnelManagerTitle}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{DynamicResource NewTunnel}"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource NewTunnel}" Style="{StaticResource SectionTitleText}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource TunnelSession}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox x:Name="ProfileInput"
                                      DisplayMemberPath="DisplayName"
                                      MinHeight="34" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource TunnelMode}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox x:Name="ModeInput"
                                      DisplayMemberPath="DisplayName"
                                      MinHeight="34"
                                      SelectionChanged="ModeInput_OnSelectionChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource ListenAddress}" Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="ListenInput"
                                     Text="127.0.0.1:1080"
                                     MinHeight="34"
                                     Padding="9,5" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="TargetLabel"
                                       Text="{DynamicResource TargetAddress}"
                                       Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="TargetInput"
                                     Text="127.0.0.1:80"
                                     MinHeight="34"
                                     Padding="9,5" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="{DynamicResource StartTunnel}"
                                Style="{StaticResource PrimaryActionButton}"
                                MinWidth="120"
                                Margin="0,23,0,0"
                                Click="StartButton_OnClick" />
                    </Grid>

                    <TextBlock x:Name="ValidationText"
                               Grid.Row="5"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="1,10,0,0" />
                </Grid>
            </Border>

            <DockPanel Grid.Row="4">
                <TextBlock Text="{DynamicResource TunnelStatus}" Style="{StaticResource SectionTitleText}" />
            </DockPanel>

            <Border Grid.Row="6" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid x:Name="TunnelGrid"
                          ItemsSource="{Binding Sessions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="TunnelGrid_OnSelectionChanged"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="36"
                          ColumnHeaderHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource TunnelSession}" Binding="{Binding SessionName}" Width="1.4*" />
                        <DataGridTextColumn Header="{DynamicResource TunnelMode}" Binding="{Binding Mode}" Width="1.2*" />
                        <DataGridTextColumn Header="{DynamicResource TunnelRoute}" Binding="{Binding Route}" Width="2.6*" />
                        <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="8" Style="{StaticResource CardBorder}" Padding="0" Background="{StaticResource SurfaceBrush}">
                <TextBox x:Name="LogText"
                         Style="{StaticResource CodeTextBox}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         BorderThickness="0" />
            </Border>

            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource CopyLog}"
                        Style="{StaticResource SecondaryActionButton}"
                        Margin="0,0,8,0"
                        Click="CopyLogButton_OnClick" />
                <Button Content="{DynamicResource StopTunnel}"
                        Style="{StaticResource SecondaryActionButton}"
                        Margin="0,0,8,0"
                        Click="StopButton_OnClick" />
                <Button Content="{DynamicResource StopAllTunnels}"
                        Style="{StaticResource DangerActionButton}"
                        Click="StopAllButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
