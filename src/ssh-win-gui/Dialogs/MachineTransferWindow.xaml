<Window x:Class="RsyncShell.App.Dialogs.MachineTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MachineTransferTitle}"
        Width="1320"
        Height="860"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Closing="MachineTransferWindow_OnClosing"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="EndpointPanel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="EndpointListItem" TargetType="ListViewItem" BasedOn="{StaticResource RemoteFileItemStyle}">
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="DirectionChoice" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ChromeBrush}">
        <Grid Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="5*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.ColumnSpan="5" LastChildFill="True">
                <Border DockPanel.Dock="Left"
                        Width="38"
                        Height="38"
                        CornerRadius="9"
                        Background="{StaticResource AccentSoftBrush}"
                        Margin="0,0,12,0">
                    <TextBlock Text="&#xE8AB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{DynamicResource MachineTransferTitle}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{DynamicResource TipMachineTransfer}"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource EndpointPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border DockPanel.Dock="Left"
                                Width="30"
                                Height="30"
                                CornerRadius="7"
                                Background="{StaticResource AccentSoftBrush}"
                                Margin="0,0,9,0">
                            <TextBlock Text="A"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource EndpointA}"
                                   Style="{StaticResource SectionTitleText}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AEndpointText"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ComboBox x:Name="AHostComboBox"
                              Grid.Row="2"
                              Height="34"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="EndpointHost_OnSelectionChanged"
                              Tag="A" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="APathTextBox"
                                 Height="34"
                                 Padding="9,5"
                                 VerticalContentAlignment="Center"
                                 KeyDown="EndpointPath_OnKeyDown"
                                 Tag="A" />
                        <Button Grid.Column="2"
                                Content="&#xE74A;"
                                Style="{StaticResource CompactIconButton}"
                                ToolTip="{DynamicResource ParentDirectory}"
                                Click="EndpointParent_OnClick"
                                Tag="A" />
                        <Button Grid.Column="4"
                                Content="&#xE72C;"
                                Style="{StaticResource CompactIconButton}"
                                ToolTip="{DynamicResource Refresh}"
                                Click="EndpointRefresh_OnClick"
                                Tag="A" />
                    </Grid>

                    <ListView x:Name="AFileList"
                              Grid.Row="6"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource EndpointListItem}"
                              BorderThickness="1"
                              MouseDoubleClick="EndpointFileList_OnMouseDoubleClick"
                              Tag="A">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource ColumnName}" Width="205">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Width="23" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Modified}" DisplayMemberBinding="{Binding ModifiedDisplay}" Width="125" />
                                <GridViewColumn Header="{DynamicResource Size}" DisplayMemberBinding="{Binding SizeDisplay}" Width="75" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <DockPanel Grid.Row="7" Margin="1,9,1,0">
                        <ProgressBar x:Name="AProgress"
                                     Width="85"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     DockPanel.Dock="Right" />
                        <TextBlock x:Name="AStatusText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="14">
                        <Border Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource ChromeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TransferDirection}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="2,0,0,9" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="AToBRadio"
                                                 Content="A  →  B"
                                                 GroupName="Direction"
                                                 IsChecked="True"
                                                 Style="{StaticResource DirectionChoice}"
                                                 Checked="Direction_OnChanged" />
                                    <RadioButton x:Name="BToARadio"
                                                 Grid.Column="2"
                                                 Content="A  ←  B"
                                                 GroupName="Direction"
                                                 Style="{StaticResource DirectionChoice}"
                                                 Checked="Direction_OnChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Center">
                            <Button x:Name="DiscoverRoutesButton"
                                    Content="{DynamicResource DiscoverRoutes}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    Width="170"
                                    Height="38"
                                    HorizontalContentAlignment="Center"
                                    Click="DiscoverRoutes_OnClick" />
                            <Button x:Name="StartTransferButton"
                                    Content="{DynamicResource StartTransfer}"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Width="170"
                                    Height="40"
                                    Margin="0,8"
                                    HorizontalContentAlignment="Center"
                                    Click="StartTransfer_OnClick" />
                            <Button Content="{DynamicResource PreviewCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    Width="170"
                                    Height="38"
                                    HorizontalContentAlignment="Center"
                                    Click="PreviewCommand_OnClick" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource ChromeBorderBrush}" />

                    <ScrollViewer Grid.Row="2"
                                  Margin="14,12,6,14"
                                  Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <TextBlock Text="{DynamicResource RsyncOptions}" Style="{StaticResource SectionTitleText}" />
                        <CheckBox x:Name="ArchiveCheckBox" IsChecked="True" Margin="0,10,0,3">
                            <TextBlock Text="{DynamicResource ArchiveOption}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CompressCheckBox" IsChecked="True" Margin="0,3">
                            <TextBlock Text="{DynamicResource CompressOption}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="DeleteCheckBox" Margin="0,3">
                            <TextBlock Text="{DynamicResource DeleteOption}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="DryRunCheckBox" Margin="0,3,0,12">
                            <TextBlock Text="{DynamicResource DryRunOption}" TextWrapping="Wrap" />
                        </CheckBox>

                        <TextBlock Text="{DynamicResource BandwidthLimit}" Style="{StaticResource FieldLabelText}" />
                        <TextBox x:Name="BandwidthTextBox"
                                 Text="0"
                                 Height="32"
                                 Padding="8,4"
                                 Margin="0,0,0,11"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="{DynamicResource ExtraArguments}" Style="{StaticResource FieldLabelText}" />
                        <TextBox x:Name="ExtraArgumentsTextBox"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="{DynamicResource ExtraArgumentsHint}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="1,6,1,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource EndpointPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border DockPanel.Dock="Left"
                                Width="30"
                                Height="30"
                                CornerRadius="7"
                                Background="{StaticResource AccentSoftBrush}"
                                Margin="0,0,9,0">
                            <TextBlock Text="B"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource EndpointB}"
                                   Style="{StaticResource SectionTitleText}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="BEndpointText"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ComboBox x:Name="BHostComboBox"
                              Grid.Row="2"
                              Height="34"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="EndpointHost_OnSelectionChanged"
                              Tag="B" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BPathTextBox"
                                 Height="34"
                                 Padding="9,5"
                                 VerticalContentAlignment="Center"
                                 KeyDown="EndpointPath_OnKeyDown"
                                 Tag="B" />
                        <Button Grid.Column="2"
                                Content="&#xE74A;"
                                Style="{StaticResource CompactIconButton}"
                                ToolTip="{DynamicResource ParentDirectory}"
                                Click="EndpointParent_OnClick"
                                Tag="B" />
                        <Button Grid.Column="4"
                                Content="&#xE72C;"
                                Style="{StaticResource CompactIconButton}"
                                ToolTip="{DynamicResource Refresh}"
                                Click="EndpointRefresh_OnClick"
                                Tag="B" />
                    </Grid>

                    <ListView x:Name="BFileList"
                              Grid.Row="6"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource EndpointListItem}"
                              BorderThickness="1"
                              MouseDoubleClick="EndpointFileList_OnMouseDoubleClick"
                              Tag="B">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource ColumnName}" Width="205">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Width="23" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Modified}" DisplayMemberBinding="{Binding ModifiedDisplay}" Width="125" />
                                <GridViewColumn Header="{DynamicResource Size}" DisplayMemberBinding="{Binding SizeDisplay}" Width="75" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <DockPanel Grid.Row="7" Margin="1,9,1,0">
                        <ProgressBar x:Name="BProgress"
                                     Width="85"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     DockPanel.Dock="Right" />
                        <TextBlock x:Name="BStatusText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource CardBorder}" Padding="0">
                <TabControl x:Name="TransferTabs" BorderThickness="0" Margin="8">
                    <TabItem x:Name="RouteProbeTab" Header="{DynamicResource RouteProbeResults}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <ProgressBar x:Name="RouteProbeProgress"
                                                 Width="110"
                                                 Height="5"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center" />
                                    <Button Content="{DynamicResource ViewDiagnosticLog}"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Margin="0,0,8,0"
                                            Click="ViewDiagnosticLog_OnClick" />
                                    <Button Content="{DynamicResource CopyProbeResults}"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Click="CopyProbeResults_OnClick" />
                                </StackPanel>
                                <TextBlock x:Name="RouteProbeStatusText"
                                           Text="{DynamicResource RouteProbeNotRun}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ListView x:Name="RouteResultsList"
                                      Grid.Row="2"
                                      SelectionMode="Single"
                                      SelectionChanged="RouteResultsList_OnSelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource ExecuteOn}" DisplayMemberBinding="{Binding ExecuteOn}" Width="125" />
                                        <GridViewColumn Header="{DynamicResource TargetSession}" DisplayMemberBinding="{Binding TargetSession}" Width="125" />
                                        <GridViewColumn Header="{DynamicResource NetworkInterface}" DisplayMemberBinding="{Binding InterfaceName}" Width="100" />
                                        <GridViewColumn Header="IP" DisplayMemberBinding="{Binding Host}" Width="145" />
                                        <GridViewColumn Header="{DynamicResource Port}" DisplayMemberBinding="{Binding Port}" Width="60" />
                                        <GridViewColumn Header="{DynamicResource Status}" DisplayMemberBinding="{Binding Status}" Width="80" />
                                        <GridViewColumn Header="{DynamicResource Latency}" DisplayMemberBinding="{Binding LatencyDisplay}" Width="75" />
                                        <GridViewColumn Header="{DynamicResource Fingerprint}" DisplayMemberBinding="{Binding Fingerprint}" Width="185" />
                                        <GridViewColumn Header="{DynamicResource Details}" DisplayMemberBinding="{Binding Message}" Width="320" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TransferJobsTab" Header="{DynamicResource TransferJobs}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource CopyLog}"
                                        Style="{StaticResource SecondaryActionButton}"
                                        Margin="0,0,8,0"
                                        Click="CopyJobLog_OnClick" />
                                <Button Content="{DynamicResource CancelSelectedJob}"
                                        Style="{StaticResource DangerActionButton}"
                                        Click="CancelSelectedJob_OnClick" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <ListView x:Name="JobsList" SelectionChanged="JobsList_OnSelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="42" />
                                            <GridViewColumn Header="{DynamicResource Status}" DisplayMemberBinding="{Binding Status}" Width="85" />
                                            <GridViewColumn Header="{DynamicResource Progress}" DisplayMemberBinding="{Binding Progress}" Width="125" />
                                            <GridViewColumn Header="{DynamicResource Speed}" DisplayMemberBinding="{Binding Speed}" Width="90" />
                                            <GridViewColumn Header="{DynamicResource Source}" DisplayMemberBinding="{Binding Source}" Width="190" />
                                            <GridViewColumn Header="{DynamicResource Destination}" DisplayMemberBinding="{Binding Destination}" Width="190" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <GridSplitter Grid.Column="1"
                                              Width="8"
                                              HorizontalAlignment="Stretch"
                                              Background="Transparent"
                                              ResizeBehavior="PreviousAndNext" />
                                <TextBox x:Name="JobLogTextBox"
                                         Grid.Column="2"
                                         Style="{StaticResource CodeTextBox}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
