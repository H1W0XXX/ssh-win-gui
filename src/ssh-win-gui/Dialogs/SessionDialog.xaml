<Window x:Class="RsyncShell.App.Dialogs.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource SessionName}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <TextBox x:Name="NameInput" Grid.Column="1" Margin="0,0,0,10" Padding="7,4" />

            <TextBlock Grid.Row="1" Text="{DynamicResource Host}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <TextBox x:Name="HostInput" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="7,4" />

            <TextBlock Grid.Row="2" Text="{DynamicResource Port}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <TextBox x:Name="PortInput" Grid.Row="2" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="7,4" />

            <TextBlock Grid.Row="3" Text="{DynamicResource Username}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <TextBox x:Name="UsernameInput" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="7,4" />

            <TextBlock Grid.Row="4" Text="{DynamicResource Group}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <ComboBox x:Name="GroupInput"
                      Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,0,0,10"
                      Padding="7,4"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True" />

            <TextBlock Grid.Row="5" Text="{DynamicResource PrivateKeyOptional}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PrivateKeyInput"
                          Padding="7,4"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True" />
                <Button Grid.Column="1" Content="{DynamicResource Browse}" Margin="7,0,0,0" Padding="11,4" Click="BrowseButton_OnClick" />
            </Grid>

            <TextBlock Grid.Row="6" Text="{DynamicResource ProxyType}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <ComboBox x:Name="ProxyTypeInput" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="7,4"
                      SelectionChanged="ProxyTypeInput_OnSelectionChanged" />

            <TextBlock x:Name="ProxyDetailsLabel" Grid.Row="7" Text="{DynamicResource ProxyServer}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <Grid x:Name="SocksProxyPanel" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProxyHostInput" Padding="7,4" />
                <TextBox x:Name="ProxyPortInput" Grid.Column="2" Padding="7,4" />
            </Grid>
            <ComboBox x:Name="JumpProfileInput" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" Padding="7,4"
                      DisplayMemberPath="Display" />

            <CheckBox x:Name="FavoriteInput" Grid.Row="8" Grid.Column="1" Content="{DynamicResource Favorite}" />
        </Grid>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="1"
                   Margin="0,12,0,0"
                   Foreground="Firebrick"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Cancel}" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{DynamicResource Save}" Width="88" Margin="0,0,8,0" Click="SaveButton_OnClick" />
            <Button Content="{DynamicResource SaveConnect}" MinWidth="128" IsDefault="True" Click="SaveConnectButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
