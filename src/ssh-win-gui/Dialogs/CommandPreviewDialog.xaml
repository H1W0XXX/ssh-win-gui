<Window x:Class="RsyncShell.App.Dialogs.CommandPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Preview}"
        Width="820"
        Height="440"
        MinWidth="560"
        MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="CommandTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="13"
                 Padding="9" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource CopyCommand}" Width="105" Margin="0,0,8,0" Click="CopyButton_OnClick" />
            <Button Content="{DynamicResource CloseWindow}" Width="88" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
