<Window x:Class="RsyncShell.App.Dialogs.AuthenticationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AuthenticationTitle}"
        Width="510"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource ConnectToSsh}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="EndpointText" Margin="0,5,0,15" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1" Padding="14" Background="White">
            <StackPanel>
                <RadioButton x:Name="PasswordRadio"
                             Content="{DynamicResource PasswordOption}"
                             IsChecked="True"
                             Checked="AuthenticationKind_OnChanged" />
                <PasswordBox x:Name="PasswordInput" Margin="22,7,0,13" Padding="7,4" />

                <RadioButton x:Name="PrivateKeyRadio"
                             Content="{DynamicResource PrivateKey}"
                             Checked="AuthenticationKind_OnChanged" />
                <Grid x:Name="PrivateKeyPanel" Margin="22,7,0,0" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource KeyFile}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBox x:Name="PrivateKeyPathInput" Grid.Column="1" Padding="7,4" />
                    <Button Grid.Column="2" Content="{DynamicResource Browse}" Margin="7,0,0,0" Padding="10,4" Click="BrowseKeyButton_OnClick" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource Passphrase}" VerticalAlignment="Center" Margin="0,9,9,0" />
                    <PasswordBox x:Name="PrivateKeyPassphraseInput" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,9,0,0" Padding="7,4" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="Firebrick"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource Cancel}" Width="86" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{DynamicResource Connect}" Width="96" IsDefault="True" Click="ConnectButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
