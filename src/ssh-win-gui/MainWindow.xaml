<Window x:Class="RsyncShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ssh-win-gui"
        Width="980"
        Height="730"
        MinWidth="760"
        MinHeight="520"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="{StaticResource ChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="52" />
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="23" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="205" MaxWidth="560" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0" Grid.ColumnSpan="3"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource ChromeBorderBrush}"
              BorderThickness="0,0,0,1"
              Foreground="{StaticResource TextBrush}"
              Padding="2,0">
            <MenuItem Header="{DynamicResource MenuTerminal}">
                <MenuItem Header="{DynamicResource NewSshSession}" Click="NewSessionButton_OnClick" />
                <MenuItem Header="{DynamicResource CloseCurrentSession}" Click="CloseSessionMenu_OnClick" />
                <Separator />
                <MenuItem Header="{DynamicResource Exit}" Click="ExitMenu_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuSessions}">
                <MenuItem Header="{DynamicResource NewSshSession}" Click="NewSessionButton_OnClick" />
                <MenuItem x:Name="EditSessionMenuItem" Header="{DynamicResource Edit}" IsEnabled="False" Click="EditSessionButton_OnClick" />
                <MenuItem x:Name="DeleteSessionMenuItem" Header="{DynamicResource Delete}" IsEnabled="False" Click="DeleteSessionButton_OnClick" />
                <Separator />
                <MenuItem Header="{DynamicResource SavedSessions}" Click="SessionsRailButton_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuView}">
                <MenuItem Header="{DynamicResource SessionsPanel}" Click="SessionsRailButton_OnClick" />
                <MenuItem Header="{DynamicResource RemoteFiles}" Click="BrowserRailButton_OnClick" />
                <MenuItem Header="{DynamicResource RsyncTransfers}" Click="TransfersRailButton_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuTransfer}">
                <MenuItem x:Name="UploadMenuItem" Header="{DynamicResource UploadWithRsync}" IsEnabled="False" Click="UploadButton_OnClick" />
                <MenuItem x:Name="UploadFolderMenuItem" Header="{DynamicResource UploadFolderWithRsync}" IsEnabled="False" Click="UploadFolderButton_OnClick" />
                <MenuItem x:Name="DownloadMenuItem" Header="{DynamicResource DownloadSelectedWithRsync}" IsEnabled="False" Click="DownloadButton_OnClick" />
                <Separator />
                <MenuItem Header="{DynamicResource ShowTransferLog}" Click="TransfersRailButton_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuSettings}">
                <MenuItem Header="{DynamicResource KeywordHighlighting}">
                    <MenuItem x:Name="KeywordHighlightingEnabledMenuItem"
                              Header="{DynamicResource EnableKeywordHighlighting}"
                              IsCheckable="True"
                              Click="KeywordHighlightingEnabledMenuItem_OnClick" />
                    <MenuItem Header="{DynamicResource CustomizeKeywords}"
                              Click="CustomizeKeywordsMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="{DynamicResource MousePaste}">
                    <MenuItem x:Name="MiddleMousePasteMenuItem" Header="{DynamicResource PasteWithMiddleMouse}" IsCheckable="True" Click="MiddleMousePasteMenuItem_OnClick" />
                    <MenuItem x:Name="RightMousePasteMenuItem" Header="{DynamicResource PasteWithRightMouse}" IsCheckable="True" Click="RightMousePasteMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="{DynamicResource MenuLanguage}">
                    <MenuItem x:Name="EnglishLanguageMenuItem" Header="{DynamicResource LanguageEnglish}" IsCheckable="True" Click="EnglishLanguageMenuItem_OnClick" />
                    <MenuItem x:Name="ChineseLanguageMenuItem" Header="{DynamicResource LanguageChinese}" IsCheckable="True" Click="ChineseLanguageMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource ExportSettings}" Click="ExportSettingsMenuItem_OnClick" />
                <MenuItem Header="{DynamicResource ImportSettings}" Click="ImportSettingsMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuHelp}">
                <MenuItem Header="{DynamicResource AboutRsyncShell}" Click="AboutMenu_OnClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="7,1,0,1">
                    <Button Style="{StaticResource CommandTileButton}" ToolTip="{DynamicResource TipNewSession}" Click="NewSessionButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource ToolbarSession}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandTileButton}" ToolTip="{DynamicResource TipTunnelManager}" Click="TunnelButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource ToolbarTunnel}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandTileButton}" ToolTip="{DynamicResource TipMachineTransfer}" Click="MachineTransferButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource ToolbarMachineTransfer}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TerminalTabStrip" Orientation="Horizontal">
                        <ToggleButton x:Name="HomeTabButton"
                                      IsChecked="True"
                                      Style="{StaticResource TerminalTabButton}"
                                      MinWidth="70"
                                      MaxWidth="82"
                                      Click="HomeTabButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Home}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="AddTabButton"
                                Width="38"
                                Height="35"
                                Style="{StaticResource ToolbarButton}"
                                FontSize="18"
                                Content="＋"
                                ToolTip="{DynamicResource NewSshSession}"
                                Click="NewSessionButton_OnClick" />
                    </StackPanel>
                </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="2" Grid.RowSpan="2" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource ChromeBorderBrush}"
                      ResizeBehavior="PreviousAndNext" />

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <ToggleButton x:Name="SessionsRailButton"
                                      Style="{StaticResource RailButton}"
                                      IsChecked="True"
                                      Content="&#xE8B7;"
                                      ToolTip="{DynamicResource TipSessions}"
                                      Click="SessionsRailButton_OnClick" />
                        <ToggleButton x:Name="BrowserRailButton"
                                      Style="{StaticResource RailButton}"
                                      Content="&#xE838;"
                                      ToolTip="{DynamicResource TipSshBrowser}"
                                      Click="BrowserRailButton_OnClick" />
                        <ToggleButton x:Name="TransfersRailButton"
                                      Style="{StaticResource RailButton}"
                                      Content="&#xE896;"
                                      ToolTip="{DynamicResource TipRsyncTransfers}"
                                      Click="TransfersRailButton_OnClick" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid x:Name="SessionsPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Background="{StaticResource SurfaceSubtleBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource SavedSessionsUpper}" Margin="10,8" FontSize="11" FontWeight="SemiBold" Foreground="#59636E" />
                            <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="＋" ToolTip="{DynamicResource NewSshSession}" Click="NewSessionButton_OnClick" />
                        </Grid>
                        <TreeView x:Name="SessionTree"
                                  Grid.Row="1"
                                  BorderThickness="0"
                                  Padding="5"
                                  FontSize="13"
                                  HorizontalContentAlignment="Stretch"
                                  PreviewMouseLeftButtonDown="SessionTree_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="SessionTree_OnPreviewMouseRightButtonDown"
                                  ContextMenuOpening="SessionTree_OnContextMenuOpening"
                                  SelectedItemChanged="SessionTree_OnSelectedItemChanged">
                            <TreeView.Resources>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="2,2" />
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Border Background="Transparent"
                                                        HorizontalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Edit}"
                                              Click="EditSessionButton_OnClick" />
                                    <MenuItem Header="{DynamicResource Delete}"
                                              Click="DeleteSessionButton_OnClick" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                        <Border Grid.Row="2" BorderBrush="#E0E3E6" BorderThickness="0,1,0,0" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="SessionCountText" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{DynamicResource DoubleClickSession}" FontSize="11" Foreground="#8A929B" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="EditSessionButton" Content="{DynamicResource Edit}" Padding="10,3" Margin="0,0,6,0" IsEnabled="False" Click="EditSessionButton_OnClick" />
                                    <Button x:Name="DeleteSessionButton" Content="{DynamicResource Delete}" Padding="10,3" IsEnabled="False" Click="DeleteSessionButton_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="BrowserPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="37" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="27" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" BorderBrush="#E0E3E6" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="4,4">
                                <Button x:Name="ParentDirectoryButton" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource TipParentDirectory}" IsEnabled="False" Click="ParentDirectoryButton_OnClick">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                </Button>
                                <Button x:Name="DownloadButton" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource TipDownloadRsync}" IsEnabled="False" Click="DownloadButton_OnClick">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#1A70C4" />
                                </Button>
                                <Button x:Name="UploadButton" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource TipUploadRsync}" IsEnabled="False" Click="UploadButton_OnClick">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#009C72" />
                                </Button>
                                <Button x:Name="UploadFolderButton" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource TipUploadFolderRsync}" IsEnabled="False" Click="UploadFolderButton_OnClick">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#009C72" />
                                </Button>
                                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource TipRefreshSsh}" IsEnabled="False" Click="RefreshButton_OnClick">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#23824D" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="5,4">
                            <ComboBox x:Name="RemotePathBox"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Padding="5,1"
                                      VerticalContentAlignment="Center"
                                      KeyDown="RemotePathBox_OnKeyDown" />
                        </Grid>
                        <ListView x:Name="RemoteFileList"
                                  Grid.Row="2"
                                  Margin="4,0"
                                  BorderBrush="#D3D7DB"
                                  ItemContainerStyle="{StaticResource RemoteFileItemStyle}"
                                  SelectionMode="Extended"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  PreviewMouseRightButtonDown="RemoteFileList_OnPreviewMouseRightButtonDown"
                                  MouseDoubleClick="RemoteFileList_OnMouseDoubleClick">
                            <ListView.ContextMenu>
                                <ContextMenu Opened="RemoteFileContextMenu_OnOpened">
                                    <MenuItem x:Name="CopyRemotePathMenuItem"
                                              Header="{DynamicResource CopyRemotePath}"
                                              Click="CopyRemotePathMenuItem_OnClick" />
                                    <MenuItem x:Name="RenameRemoteItemMenuItem"
                                              Header="{DynamicResource Rename}"
                                              Click="RenameRemoteItemMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem x:Name="DeleteRemoteItemsMenuItem"
                                              Header="{DynamicResource Delete}"
                                              Click="DeleteRemoteItemsMenuItem_OnClick" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="{DynamicResource ColumnName}" Width="232">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock x:Name="FileGlyph"
                                                               Text="&#xE8A5;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               Foreground="#637487"
                                                               Width="23"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="FileNameText"
                                                               Text="{Binding Name}"
                                                               Foreground="#152A44"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSymbolicLink}" Value="True">
                                                        <Setter TargetName="FileGlyph" Property="Text" Value="&#xE71B;" />
                                                        <Setter TargetName="FileGlyph" Property="Foreground" Value="#7A5CAF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter TargetName="FileGlyph" Property="Text" Value="&#xE8B7;" />
                                                        <Setter TargetName="FileGlyph" Property="Foreground" Value="#E0A400" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsParent}" Value="True">
                                                        <Setter TargetName="FileGlyph" Property="Text" Value="&#xE74A;" />
                                                        <Setter TargetName="FileGlyph" Property="Foreground" Value="#29845B" />
                                                        <Setter TargetName="FileNameText" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Border Grid.Row="3" BorderBrush="#E0E3E6" BorderThickness="0,1,0,0" Padding="7,4">
                            <DockPanel>
                                <TextBlock x:Name="BrowserItemCountText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="BrowserStatusText" Text="{DynamicResource NoActiveSshSession}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="TransfersPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="11,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource RsyncTransfersUpper}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#59636E" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CopyTransferLogButton"
                                        Content="{DynamicResource CopyLog}"
                                        Padding="9,3"
                                        Margin="0,0,5,0"
                                        IsEnabled="False"
                                        Click="CopyTransferLogButton_OnClick" />
                                <Button x:Name="CancelTransferButton"
                                        Content="{DynamicResource CancelAllTransfers}"
                                        Padding="9,3"
                                        IsEnabled="False"
                                        Click="CancelTransferButton_OnClick" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="TransferLogTextBox"
                                 Grid.Row="1"
                                 Margin="7"
                                 Padding="5"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Grid.Column="2" Background="{StaticResource TerminalBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="TerminalStage">
                <Grid x:Name="HomeView" Background="{StaticResource ChromeBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="58" Height="58" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ssh-win-gui" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource HomeSubtitle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="15"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Border x:Name="RemoteMonitoringPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid Height="26">
                        <ScrollViewer x:Name="MonitorMetricsPanel"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border BorderBrush="#D3D7DB" BorderThickness="0,0,1,0" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource MonitorCpu}" Foreground="#59636E" Margin="0,0,4,0" />
                                        <TextBlock x:Name="MonitorCpuText" Foreground="#173A5E" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D3D7DB" BorderThickness="0,0,1,0" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource MonitorMemory}" Foreground="#59636E" Margin="0,0,4,0" />
                                        <TextBlock x:Name="MonitorMemoryText" Foreground="#173A5E" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D3D7DB" BorderThickness="0,0,1,0" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource MonitorNetwork}" Foreground="#59636E" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <ComboBox x:Name="NetworkInterfaceInput"
                                                  Width="86"
                                                  Height="21"
                                                  Padding="3,0"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip="{DynamicResource NetworkInterfaceTooltip}"
                                                  SelectionChanged="NetworkInterfaceInput_OnSelectionChanged" />
                                        <TextBlock x:Name="MonitorNetworkText" Foreground="#173A5E" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource MonitorDisk}" Foreground="#59636E" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DiskMountInput"
                                                  Width="96"
                                                  Height="21"
                                                  Padding="3,0"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip="{DynamicResource DiskMountTooltip}"
                                                  SelectionChanged="DiskMountInput_OnSelectionChanged" />
                                        <TextBlock x:Name="MonitorDiskText" Foreground="#173A5E" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="MonitoringStatusText"
                                   Visibility="Collapsed"
                                   Margin="8,4"
                                   Foreground="#687380"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Border x:Name="GpuMonitorRow"
                            Visibility="Collapsed"
                            Height="24"
                            Background="#F1F3F5"
                            BorderBrush="#D3D7DB"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{DynamicResource MonitorGpu}"
                                       Foreground="#59636E"
                                       FontWeight="SemiBold"
                                       Margin="8,4,5,0" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="GpuMonitorItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#CDD2D7" BorderThickness="1" CornerRadius="2" Margin="2,2,3,2" Padding="5,1" Background="White">
                                                <TextBlock Text="{Binding}" Foreground="#314B65" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Visibility="Collapsed" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConnectionStatusText" Text="{DynamicResource Ready}" Foreground="#45515E" Margin="8,4" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" BorderBrush="#C7CCD2" BorderThickness="1,0,0,0" Padding="9,4">
                        <TextBlock x:Name="ActivePathStatusText" Text="—" Foreground="#53606D" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#C7CCD2" BorderThickness="1,0,0,0" Padding="9,4">
                        <TextBlock x:Name="ActiveUserText" Text="{DynamicResource Local}" Foreground="#45515E" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Grid.ColumnSpan="3" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,1,0,0" Padding="9,2">
            <DockPanel>
                <TextBlock x:Name="ToolStatusText" DockPanel.Dock="Right" Foreground="#687380" />
                <TextBlock Text="{DynamicResource FooterSummary}" Foreground="#687380" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
